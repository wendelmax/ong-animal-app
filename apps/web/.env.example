# Banco de dados PostgreSQL (compatível com o docker-compose local)
DATABASE_URL=postgresql://root:rootpassword@127.0.0.1:5432/ong_animal

# Segredo do Payload (gere uma chave aleatória e segura para produção)
PAYLOAD_SECRET=viralatinhas_secret_key_change_me_in_production

# URL base do servidor
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob Storage (opcional em desenvolvimento local; em dev usa storage em disco)
BLOB_READ_WRITE_TOKEN=
BLOB_STORAGE_URL=

# Armazenamento privado R2 dos arquivos do cadastro de voluntários
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Rate limit das rotas públicas
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Proteção de CPF e cron de limpeza
VOLUNTEER_CPF_ENCRYPTION_KEY=
VOLUNTEER_CPF_HMAC_PEPPER=
CRON_SECRET=

# Fronteira interna de exportação para migração progressiva ao NodePress
NODEPRESS_BRIDGE_TOKEN=
NODEPRESS_BRIDGE_AUDIENCE=nodepress
